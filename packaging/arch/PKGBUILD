pkgname=oblinux-branding
pkgver=1.0.0
pkgrel=1
_source_commit=df458d75605144b94d2839e1db0573904245eb6b
pkgdesc='Shared OBLinux R5 visual identity assets'
arch=('any')
url='https://github.com/marcoobaid/oblinux-brand-master'
license=('MIT' 'custom:OBLinux-brand')
makedepends=('python' 'librsvg')
optdepends=('inter-font: primary OBLinux typography')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_source_commit.tar.gz")
sha256sums=('33a804ffe1a3f83cf596c9b8402181e634e9a2d4f92699f27403606d27cf822b')

build() {
  cd "oblinux-brand-master-$_source_commit"
  python3 scripts/generate-assets.py
}

check() {
  cd "oblinux-brand-master-$_source_commit"
  python3 tests/validate.py
}

package() {
  cd "oblinux-brand-master-$_source_commit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 TRADEMARKS.md "$pkgdir/usr/share/licenses/$pkgname/TRADEMARKS.md"
  install -dm755 "$pkgdir/usr/share/oblinux"
  cp -a brand "$pkgdir/usr/share/oblinux/"
  install -dm755 "$pkgdir/usr/share/backgrounds/oblinux" "$pkgdir/usr/share/gnome-background-properties" "$pkgdir/etc/dconf/db/local.d" "$pkgdir/usr/share/icons/hicolor"
  cp -a assets/wallpapers/. "$pkgdir/usr/share/backgrounds/oblinux/"
  install -m644 assets/gnome/oblinux-backgrounds.xml "$pkgdir/usr/share/gnome-background-properties/"
  install -m644 assets/gnome/00-oblinux-backgrounds "$pkgdir/etc/dconf/db/local.d/"
  cp -a assets/icons/hicolor/. "$pkgdir/usr/share/icons/hicolor/"
  install -dm755 "$pkgdir/usr/share/plymouth/themes" "$pkgdir/usr/share/grub/themes" "$pkgdir/usr/share/calamares/branding"
  cp -a themes/plymouth/oblinux "$pkgdir/usr/share/plymouth/themes/"
  cp -a themes/grub/oblinux "$pkgdir/usr/share/grub/themes/"
  cp -a themes/calamares/oblinux "$pkgdir/usr/share/calamares/branding/"
}
