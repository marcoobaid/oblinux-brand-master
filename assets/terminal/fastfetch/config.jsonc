{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/oblinux/terminal/fastfetch/logo.txt",
    "color": {
      "1": "38;2;30;77;140",
      "2": "38;2;255;138;0"
    },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;30;77;140",
      "title": "38;2;30;77;140",
      "output": "default",
      "separator": "default"
    },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Device" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" }
  ]
}
